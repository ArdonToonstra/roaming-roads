# Roaming Roads — local environment variables
# Copy this to .env.local and fill in your actual values

# MapTiler API key (optional - for better map tiles: satellite imagery, place
# name labels, and search). Get a free key at: https://www.maptiler.com/
# Without it, the site falls back to plain OpenStreetMap tiles.
NEXT_PUBLIC_MAPTILER_KEY=

# Development optimizations
NODE_OPTIONS=--no-deprecation

# Analytics (Umami — privacy-respecting, cookie-free, no consent banner needed)
# Set these once Umami is running on the Pi and exposed via Cloudflare Tunnel
# See PI-MIGRATION.md for setup instructions
# NEXT_PUBLIC_UMAMI_URL=https://umami.roamingroads.nl
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
